# nixtropic test fixture: the PINs the card ACTUALLY has right now.
#
# The validate scripts never guess or probe a PIN: a wrong PIN burns a retry
# (and on M&D-backed PINs a chip slot).  They read the PINs from here and stop
# at the first failed VERIFY.
#
#   cp tools/fixture.env.example tools/fixture.env   # gitignored
#   # edit if the card's PINs are not the factory defaults
#
# Override the path with NIXTROPIC_FIXTURE=/path/to/file.
#
# Note: validate-openpgp.sh and validate-pin-md.sh end with TERMINATE +
# ACTIVATE, which puts the card back to the factory defaults below.

# OpenPGP user PIN (PW1), 6..127 printable ASCII characters.  Factory: 123456
NIXTROPIC_PW1=123456
# OpenPGP admin PIN (PW3), 8..127 printable ASCII characters.  Factory: 12345678
NIXTROPIC_PW3=12345678
# validate-pin-md.sh changes PW1 to this before its wrong-PIN attempts, which
# binds PW1 to the MAC-and-Destroy counter.  Must differ from NIXTROPIC_PW1.
NIXTROPIC_PW1_MD_TEST=246813
